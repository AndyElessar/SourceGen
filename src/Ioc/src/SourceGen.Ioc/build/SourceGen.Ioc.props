<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    This file is automatically included when referencing the SourceGen.Ioc package.
    It defines the SOURCEGEN constant, so that the IoC attributes (marked with [Conditional("SOURCEGEN")])
    are kept in the compiled output in both Debug and Release configurations.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SOURCEGEN</DefineConstants>
  </PropertyGroup>
</Project>
