<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import the props file to define SOURCEGEN_IOC constant (simulating PackageReference behavior) -->
  <Import Project="..\..\src\SourceGen.Ioc\build\SourceGen.Ioc.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- StoreAliasConsumer tests a key that is equal to a registered key only at run time, which SGIOC505 reports -->
    <NoWarn>$(NoWarn);SGIOC505</NoWarn>
    <!-- A task that faults and that nothing observes fails the test run on the JIT; pass the same flag to the native executable yourself -->
    <RunArguments>--fail-on-unobserved-task-exceptions</RunArguments>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --fail-on-unobserved-task-exceptions</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SourceGen.Ioc\SourceGen.Ioc.csproj" />
    <ProjectReference Include="..\..\src\SourceGen.Ioc.SourceGenerator\SourceGen.Ioc.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SourceGen.Ioc.TestCase\SourceGen.Ioc.TestCase.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>