<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import the props file to define SOURCEGEN_IOC constant (simulating PackageReference behavior) -->
  <Import Project="..\..\src\SourceGen.Ioc\build\SourceGen.Ioc.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <!-- A task that faults and that nothing observes fails the test run: RunArguments for dotnet run, TestingPlatformCommandLineArguments for dotnet test -->
    <RunArguments>--fail-on-unobserved-task-exceptions</RunArguments>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --fail-on-unobserved-task-exceptions</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SourceGen.Ioc.SourceGenerator\SourceGen.Ioc.SourceGenerator.csproj" />
    <ProjectReference Include="..\..\src\SourceGen.Ioc\SourceGen.Ioc.csproj" />
  </ItemGroup>

</Project>